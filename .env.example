# Copie este arquivo para .env e ajuste. O .env não vai para o GitHub.
#   cp .env.example .env

# --- Obrigatório -------------------------------------------------------------
# Senha do banco de dados. Use letras e números (sem espaços). Não troque depois
# da primeira inicialização sem trocar também dentro do banco.
DB_SENHA=troque-esta-senha

# --- Geral ---------------------------------------------------------------------
# Fuso horário usado nos relatórios e no backup.
TZ=America/Manaus

# Primeira inicialização: "prototipo" importa equipamentos, usuários e paradas do protótipo;
# "vazio" começa sem nada (o primeiro usuário cadastrado vira administrador).
DADOS_INICIAIS=prototipo

# Portas no servidor (troque se a 80/443 já estiverem em uso).
HTTP_PORTA=80
HTTPS_PORTA=443

# --- HTTPS (opcional, ver docs/HTTPS.md) ----------------------------------------
# http               -> padrão, sem certificado
# https-certificado  -> certificado da empresa em caddy/certs/
# https-dns          -> Let's Encrypt por DNS (descomente também COMPOSE_FILE)
MODO=http
# Nome do servidor usado no HTTPS, ex.: downtime.suaempresa.com.br
SITE_ENDERECO=localhost
# COMPOSE_FILE=docker-compose.yml:docker-compose.dns.yml
# ACME_EMAIL=ti@suaempresa.com.br
# DNS_API_TOKEN=

# --- Backup --------------------------------------------------------------------
# Horário do backup diário (HH:MM) e por quantos dias guardar os arquivos em ./backups
BACKUP_HORA=02:30
BACKUP_DIAS=30

# --- Relatórios ----------------------------------------------------------------
# Chave dos links de relatório do Power Query. Em branco: gerada pelo sistema
# (o administrador vê e troca na aba Dados).
RELATORIOS_CHAVE=
# Usuário somente leitura para conectar o Power BI / Power Query direto no banco.
# Em branco: não é criado. Ver docs/POWER-QUERY.md
POWERQUERY_USUARIO=relatorios
POWERQUERY_SENHA=

# --- Recuperação de acesso -----------------------------------------------------
# Se ninguém conseguir entrar como administrador: preencha ADMIN_PIN (4 números),
# rode "docker compose up -d", entre com a matrícula abaixo e depois apague ADMIN_PIN.
ADMIN_PIN=
ADMIN_MATRICULA=10001
